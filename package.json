{
  "name": "takaven-go-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/input.css -o ./app/static/app.css --minify",
    "build:js": "esbuild ./frontend/app.js --bundle --minify --outfile=./app/static/app.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./frontend/input.css -o ./app/static/app.css --watch"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.7",
    "htmx.org": "^2.0.4"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  }
}
